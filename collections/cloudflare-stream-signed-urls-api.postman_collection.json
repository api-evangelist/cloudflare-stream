          "name": "Create a signed URL token",
          "request": {
            "name": "Create a signed URL token",
            "description": {
              "content": "Mints a signed URL token for a video, expiring in one hour by default, with optional access rules such as expiry, allowed origins, and IP restrictions. Does not support Live WebRTC playback.",
              "type": "text/plain"
            },
