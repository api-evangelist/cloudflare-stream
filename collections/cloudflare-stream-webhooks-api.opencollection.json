{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloudflare Stream Analytics Webhooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "View webhook",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/stream/webhook",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The Cloudflare account identifier."
              }
            ]
          },
          "docs": "Retrieves the current per-account webhook subscription."
        },
        {
          "info": {
            "name": "Create or update the webhook",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/stream/webhook",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The Cloudflare account identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Subscribes the single per-account webhook. Stream POSTs a signed notification to the configured URL when a video finishes processing or enters an error state."
        },
        {
          "info": {
            "name": "Delete the webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/stream/webhook",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The Cloudflare account identifier."
              }
            ]
          },
          "docs": "Deletes the per-account webhook subscription."
        }
      ]
    }
  ],
  "bundled": true
}