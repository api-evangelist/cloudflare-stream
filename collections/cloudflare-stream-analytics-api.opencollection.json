{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloudflare Stream Analytics API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account storage usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/stream/storage-usage",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The Cloudflare account identifier."
              }
            ]
          },
          "docs": "Returns the total minutes of video stored and the storage limit for the account."
        }
      ]
    }
  ],
  "bundled": true
}